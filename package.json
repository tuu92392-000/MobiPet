{
  "name": "mobipet",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MobiPet: bedside mobility companion prototype for the Temple AI Build Challenge. Demo only \u2014 all patients are fictional.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "build:demo": "vite build --config client/vite.demo.config.ts",
    "preview:demo": "vite preview --config client/vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "reset-data": "tsx server/resetData.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.21.1",
    "framer-motion": "11.11.9",
    "lucide-react": "0.452.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "recharts": "2.13.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@axe-core/react": "4.10.0",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.3"
  }
}
